(spi) {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}

	@ops path /api/__ops /api/__ops/*
	handle @ops {
		header Cache-Control no-store
		respond 404
	}
	handle_path /api/* {
		header >Cache-Control no-store
		@upload path /uploads
		request_body @upload {
			max_size {$SPI_PROXY_UPLOAD_BYTES:26345472}
		}
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up -X-Forwarded-Host
			header_up -Forwarded
		}
	}
	handle /api {
		header Cache-Control no-store
		respond 404
	}
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		root * /srv
		@versioned path_regexp asset ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
		handle @versioned {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle /assets/* {
			header Cache-Control no-store
			file_server
		}
		handle {
			header Cache-Control no-store
			try_files {path} /index.html
			file_server
		}
	}
}
