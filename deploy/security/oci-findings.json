{
  "assessments": {
    "CVE-2025-69720": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2025-69720",
      "approval": "none",
      "component": "ncurses infocmp CLI",
      "reachability_and_residual_risk": "No service calls infocmp on untrusted terminfo. Debian's source-package record also covers base and linked libraries.",
      "remediation": "No Trixie fix confirmed. Review if terminal tooling is exposed to tenant input.",
      "type": "stack buffer overflow"
    },
    "CVE-2026-116587": {
      "advisory": "https://github.com/go-jose/go-jose/security/advisories/GHSA-mgcc-cww5-fp2q",
      "approval": "none",
      "component": "go-jose v3 JWK RSA validation in Smallstep chain",
      "reachability_and_residual_risk": "Caddy TLS and local CA use trusted material. The deployed routes do not parse caller-supplied JWKs. Reassess if a remote JWK source or Smallstep provisioner is enabled.",
      "remediation": "No patched v3 release. Track Smallstep and Caddy updates; v4 alone does not cover the v3 dependency.",
      "type": "CPU denial of service"
    },
    "CVE-2026-119373": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-119373",
      "approval": "none",
      "component": "SQLite FTS5",
      "reachability_and_residual_risk": "No FTS5 tables or user-defined SQL in application paths. Auth and processing databases are created by SPI; restore is an operator path.",
      "remediation": "No Trixie fix confirmed. Keep operator backup sources authenticated and re-evaluate any future SQLite imports or FTS use.",
      "type": "heap buffer overflow and availability"
    },
    "CVE-2026-119374": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-119374",
      "approval": "none",
      "component": "SQLite FTS5 secure deletion",
      "reachability_and_residual_risk": "Requires a database with a corrupt FTS5 index and deletion in the affected mode. SPI does not use FTS5 or accept uploaded SQLite databases.",
      "remediation": "No Trixie fix confirmed. Treat the risk as open if restore input trust or SQLite features change.",
      "type": "heap memory corruption"
    },
    "CVE-2026-119379": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-119379",
      "approval": "none",
      "component": "SQLite session changesets",
      "reachability_and_residual_risk": "Requires SQLite session changeset processing. SPI does not apply user-provided changesets or expose arbitrary SQLite commands.",
      "remediation": "No Trixie fix confirmed. Re-evaluate before exposing any database changeset path.",
      "type": "memory corruption"
    },
    "CVE-2026-124709": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-124709",
      "approval": "none",
      "component": "OpenSSL QUIC server stream management",
      "reachability_and_residual_risk": "The Python service accepts TCP HTTP on a private network and has no OpenSSL QUIC listener. Caddy uses Go TLS and QUIC. Worker and sandbox are networkless.",
      "remediation": "Candidate OpenSSL Debian revision 3.5.9-1~deb13u1 still reports HIGH. Re-evaluate on a Trixie backport or a topology change.",
      "type": "memory exhaustion"
    },
    "CVE-2026-16742": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-16742",
      "approval": "none",
      "component": "systemd-homed account and group handling",
      "reachability_and_residual_risk": "The runtime packages contain libraries. SPI does not run systemd-homed or host account provisioning. Audit independently on the target host.",
      "remediation": "No Trixie fix confirmed for the source package. Re-evaluate on host or init changes.",
      "type": "local privilege escalation"
    },
    "CVE-2026-54369": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-54369",
      "approval": "none",
      "component": "libacl pathname-based ACL operations",
      "reachability_and_residual_risk": "A privileged caller would need to resolve a locally writable path. SPI does not manage ACLs from request paths, uses separate private mounts and runs without capabilities.",
      "remediation": "No Trixie backport confirmed. Retest after a Debian point release. Host ACL tooling is a separate review.",
      "type": "local privilege escalation"
    },
    "CVE-2026-76642": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-76642",
      "approval": "none",
      "component": "util-linux mount helper post-hooks",
      "reachability_and_residual_risk": "Requires the affected privileged mount context. Services have no mount capabilities or application call path to mount. Host mount tooling is separately scoped.",
      "remediation": "No Trixie fix confirmed. Keep deployment non-root and restrict host mount permissions.",
      "type": "local privileged mount side effects"
    },
    "CVE-2026-78408": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-78408",
      "approval": "none",
      "component": "util-linux nsenter cgroup mode",
      "reachability_and_residual_risk": "Requires privileged nsenter in an attacker-influenced context. No container invokes nsenter or holds host cgroup authority.",
      "remediation": "No Trixie fix confirmed. Audit host namespace tooling and privileged automation separately.",
      "type": "leaked privileged cgroup authority"
    },
    "CVE-2026-78409": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-78409",
      "approval": "none",
      "component": "util-linux libmount subtree resolution",
      "reachability_and_residual_risk": "Requires a privileged mount caller and attacker influence on mount paths. Docker mount locations come from operator config, outside tenant inputs.",
      "remediation": "No Trixie fix confirmed. Verify host mounts and restrict operators of Docker.",
      "type": "unsafe privileged mount path resolution"
    },
    "CVE-2026-78410": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-78410",
      "approval": "none",
      "component": "util-linux libmount restricted bind mounts",
      "reachability_and_residual_risk": "Requires a privileged mount path. OCI services drop capabilities and do not process user mount options.",
      "remediation": "No Trixie fix confirmed. Verify host mount inputs and preserve container restrictions.",
      "type": "unsafe privileged mount ownership changes"
    },
    "CVE-2026-78661": {
      "advisory": "https://pkg.go.dev/vuln/GO-2026-6860",
      "approval": "none",
      "component": "golang.org/x/net/html",
      "reachability_and_residual_risk": "Static files and reverse proxy routes do not parse requester HTML through this library as configured. The patched module is linked regardless of reachability.",
      "remediation": "Update to v0.62.0 and verify the rebuilt Caddy artifact.",
      "type": "parser resource exhaustion"
    },
    "CVE-2026-9538": {
      "advisory": "https://security-tracker.debian.org/tracker/CVE-2026-9538",
      "approval": "none",
      "component": "Perl Archive::Tar",
      "reachability_and_residual_risk": "SPI uses Python tarfile for bounded operator backup files. The Perl Archive::Tar module is not used for PDF, API requests or restores.",
      "remediation": "Trixie fix deferred. Reassess if an operator or new entry point uses Perl for attacker-controlled TAR data.",
      "type": "memory exhaustion"
    }
  },
