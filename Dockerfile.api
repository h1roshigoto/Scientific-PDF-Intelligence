# syntax=docker/dockerfile:1@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
ARG PYTHON_IMAGE=python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${PYTHON_IMAGE} AS dependencies
WORKDIR /build
COPY deploy/requirements.lock .
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --only-binary=:all: --require-hashes --target /opt/spi -r requirements.lock

FROM ${PYTHON_IMAGE}
RUN groupadd -g 10001 spi && useradd -u 10001 -g 10001 -M spi && \
    install -d -m 0700 -o spi -g spi /dataset /local-secret /parser /metrics /backups && \
    python -m pip uninstall -y pip && rm -rf /usr/local/lib/python3.12/ensurepip
WORKDIR /app
COPY --from=dependencies /opt/spi /opt/spi
COPY src/spi /app/src/spi
ENV PYTHONPATH=/app/src:/opt/spi PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
USER 10001:10001
