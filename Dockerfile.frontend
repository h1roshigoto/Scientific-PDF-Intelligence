# syntax=docker/dockerfile:1@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS frontend
RUN npm install --global pnpm@11.25.0
WORKDIR /app/frontend_redezigned
COPY frontend_redezigned/package.json frontend_redezigned/pnpm-lock.yaml frontend_redezigned/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY passport.md /app/passport.md
COPY frontend_redezigned/index.html frontend_redezigned/tsconfig.json frontend_redezigned/vite.config.ts ./
COPY frontend_redezigned/fixtures/demo.json ./fixtures/demo.json
COPY frontend_redezigned/src ./src
COPY frontend_redezigned/public/assets ./public/assets
ENV VITE_DATA_SOURCE=api VITE_API_BASE=/api
RUN pnpm build && test -z "$(find dist -name '*.map' -print)"

FROM caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0 AS caddy
RUN setcap -r /usr/bin/caddy

FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
RUN addgroup -g 10002 spi && adduser -D -H -u 10002 -G spi spi && \
    install -d -m 0700 -o spi -g spi /data /config
COPY --from=frontend /app/frontend_redezigned/dist /srv
COPY deploy/Caddyfile* /etc/caddy/
ENV XDG_DATA_HOME=/data XDG_CONFIG_HOME=/config
USER 10002:10002
