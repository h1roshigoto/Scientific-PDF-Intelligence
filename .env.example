# Scientific PDF Intelligence — local environment

# GigaChat API
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Optional trusted CA bundle
# GIGACHAT_CA_BUNDLE_FILE=C:/certs/russian_trusted_root_ca_pem.crt

# Backend
SPI_STATE_DIR=state
# Required to enable the PDF passport for this state directory.
# SPI_RUN_ID=e2e-dev
SPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private/local PDF upload. Keep these directories separate from each other,
# SPI_STATE_DIR, the original corpora, outputs, and the frontend.
SPI_UPLOAD_ENABLED=false
# SPI_UPLOAD_DIR=C:/Users/your-name/AppData/Local/ScientificPDFIntelligence/private-upload/pdfs
# SPI_UPLOAD_STATE_DIR=C:/Users/your-name/AppData/Local/ScientificPDFIntelligence/private-upload/metadata
SPI_UPLOAD_MAX_BYTES=26214400
SPI_UPLOAD_MAX_FILES=100
# Set SPI_UPLOAD_TOKEN in the backend process environment. See docs/DEMO_RUNBOOK.md.
