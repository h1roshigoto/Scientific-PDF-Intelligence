# Scientific PDF Intelligence — local environment

# GigaChat API
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Optional trusted CA bundle
# GIGACHAT_CA_BUNDLE_FILE=C:/certs/russian_trusted_root_ca_pem.crt

# Backend
SPI_STATE_DIR=state
SPI_AUTH_MODE=private
# Required to enable the PDF passport for this state directory.
# SPI_RUN_ID=e2e-dev
SPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private/local PDF upload. Keep these directories separate from each other,
# SPI_STATE_DIR, the original corpora, outputs, and the frontend.
SPI_UPLOAD_ENABLED=false
# SPI_UPLOAD_DIR=C:/Users/your-name/AppData/Local/ScientificPDFIntelligence/private-upload/pdfs
# SPI_UPLOAD_STATE_DIR=C:/Users/your-name/AppData/Local/ScientificPDFIntelligence/private-upload/metadata
# SPI_UPLOAD_PROCESS_STATE_DIR=C:/Users/your-name/AppData/Local/ScientificPDFIntelligence/private-upload/processing
SPI_UPLOAD_MAX_BYTES=26214400
SPI_UPLOAD_MAX_FILES=100
# Set SPI_UPLOAD_TOKEN in the backend process environment. See docs/DEMO_RUNBOOK.md.

# Multiuser settings. Opt in with SPI_AUTH_MODE=multiuser.
# Required as dedicated absolute paths outside the checkout and legacy storage.
# SPI_AUTH_DB=C:/Users/your-name/AppData/Local/ScientificPDFIntelligence/accounts/auth.sqlite3
# SPI_MULTIUSER_STORAGE_ROOT=C:/Users/your-name/AppData/Local/ScientificPDFIntelligence/multiuser
# SPI_AUTH_ALLOWED_ORIGINS=https://spi.example.org
# Set SPI_AUTH_SECRET to a fresh secrets.token_urlsafe(32) via a server secret store.
# SPI_AUTH_TRUSTED_PROXIES=127.0.0.1
SPI_AUTH_LOCAL_DEVELOPMENT=false
SPI_AUTH_COOKIE_SECURE=true
SPI_AUTH_SESSION_IDLE_SECONDS=1800
SPI_AUTH_SESSION_MAX_SECONDS=43200
SPI_AUTH_CSRF_ENABLED=true
SPI_RATE_LIMIT_ENABLED=true
SPI_PUBLIC_DEMO_ENABLED=false
SPI_USER_MAX_UPLOAD_FILES=100
SPI_USER_MAX_TOTAL_STORAGE_BYTES=524288000
SPI_USER_MAX_PDF_BYTES=26214400
SPI_USER_MAX_ACTIVE_JOBS=1
SPI_USER_MAX_QUEUED_JOBS=4
SPI_USER_MAX_MODEL_REQUESTS=80
SPI_USER_MAX_EXPORTS_PER_PERIOD=30
SPI_USER_MAX_RETRIES=3
SPI_GLOBAL_MAX_ACTIVE_JOBS=2
SPI_UPLOAD_PROCESS_MAX_MODEL_REQUESTS=8
