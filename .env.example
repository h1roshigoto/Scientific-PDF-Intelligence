# Scientific PDF Intelligence — local environment

# GigaChat API
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Optional trusted CA bundle
# GIGACHAT_CA_BUNDLE_FILE=C:/certs/russian_trusted_root_ca_pem.crt

# Backend
SPI_STATE_DIR=state
# Required to enable the PDF passport for this state directory.
# SPI_RUN_ID=e2e-dev
SPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
